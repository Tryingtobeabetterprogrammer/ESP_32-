#include <WiFi.h>

WiFiServer server(80);

const char* ssid = "vijay";
const char* password = "12345678";

// motor pins
const int pA = 2;
const int pB = 4;
const int pC = 5;
const int pD = 18;

void setup() {
  Serial.begin(115200);

  // PWM setup
  ledcAttach(pA, 5000, 8);
  ledcAttach(pB, 5000, 8);
  ledcAttach(pC, 5000, 8);
  ledcAttach(pD, 5000, 8);

  WiFi.softAP(ssid, password);
  Serial.println(WiFi.softAPIP());

  server.begin();
}

void loop() {
  WiFiClient client = server.available();

  if (client) {
    String request = client.readStringUntil('\r');
    Serial.println(request);
    client.flush();

    int speed = 0;
    int turn = 0;

    int sIndex = request.indexOf("speed=");
    int tIndex = request.indexOf("&");

    if (sIndex != -1 && tIndex != -1) {
      String sValue = request.substring(sIndex + 6, tIndex);
      speed = sValue.toInt();
    }

    int turnIndex = request.indexOf("turn=");
    int spaceIndex = request.indexOf(" ", turnIndex);

    if (turnIndex != -1 && spaceIndex != -1) {
      String tValue = request.substring(turnIndex + 5, spaceIndex);
      turn = tValue.toInt();
    }

    int leftSpeed  = speed - turn;
    int rightSpeed = speed + turn;

    leftSpeed  = constrain(leftSpeed, 0, 255);
    rightSpeed = constrain(rightSpeed, 0, 255);

    // apply to motors
    ledcWrite(pA, leftSpeed);
    ledcWrite(pC, leftSpeed);

    ledcWrite(pB, rightSpeed);
    ledcWrite(pD, rightSpeed);

    // response
    client.println("HTTP/1.1 200 OK");
    client.println("Content-Type: text/html");
    client.println("");

    client.println("<h1>Drone Control</h1>");
    client.println("<a href=\"/?speed=100&turn=0\">Forward</a><br>");
    client.println("<a href=\"/?speed=150&turn=50\">Right</a><br>");
    client.println("<a href=\"/?speed=150&turn=-50\">Left</a><br>");
    client.println("<a href=\"/?speed=0&turn=0\">Stop</a><br>");

    client.stop();
  }
}
