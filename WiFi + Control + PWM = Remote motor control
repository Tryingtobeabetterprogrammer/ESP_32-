#include <WiFi.h>

const char* ssid = "vijay";
const char* password = "12345678";

WiFiServer server(80);

const int ledPin = 2;
int speedValue = 0;

void setup() {
  Serial.begin(115200);

  ledcAttach(ledPin, 5000, 8);  // PWM setup

  WiFi.softAP(ssid, password);  // correct function
  Serial.println("WiFi started..");
  Serial.println(WiFi.softAPIP());  // correct object + method

  server.begin();
}

void loop() {
  WiFiClient client = server.available();

  if (client) {
    String request = client.readStringUntil('\r');  // correct spelling
    Serial.println(request);
    client.flush();

    if (request.indexOf("/speed=") != -1) {
      int start = request.indexOf("=") + 1;
      int end = request.indexOf(" ", start);
      String value = request.substring(start, end);
      speedValue = value.toInt();

      Serial.print("Speed set to: ");
      Serial.println(speedValue);
    }

    // Apply speed
    ledcWrite(ledPin, speedValue);

    // Web UI
    client.println("HTTP/1.1 200 OK");
    client.println("Content-Type: text/html");
    client.println("");
    client.println("<h1>Drone Throttle</h1>");
    client.println("<a href=\"/speed=50\">Low</a><br>");
    client.println("<a href=\"/speed=150\">Medium</a><br>");
    client.println("<a href=\"/speed=255\">High</a><br>");

    client.stop();
  }
}
