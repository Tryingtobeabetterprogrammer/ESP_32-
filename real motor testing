const int in1 = 25;
const int in2 = 26;

void setup() {

  Serial.begin(115200);

  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);

}

void loop() {

  // Forward
  Serial.println("Forward");

  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);

  delay(3000);

  // Stop
  Serial.println("Stop");

  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);

  delay(2000);

  // Reverse
  Serial.println("Reverse");

  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);

  delay(3000);

  // Stop again
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);

  delay(2000);
}
